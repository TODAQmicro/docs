---
import { ScalarComponent } from '@scalar/astro';

import Head from '../components/Head.astro';
import Header from '../components/Header/Header.astro';
import '../styles/main.css';

/**
 * The reference renders whatever the API is currently serving. The payment API
 * generates its own OpenAPI document from the mounted route table and serves it
 * with permissive CORS, so the docs never need a vendored copy to refresh.
 *
 * Point PUBLIC_OPENAPI_URL at staging or a local server to preview changes
 * before they reach production.
 */
const openApiUrl =
  import.meta.env.PUBLIC_OPENAPI_URL ?? 'https://pay.m.todaq.net/v4/openapi.json';

/**
 * Aligns Scalar's palette and type with the rest of the site. Scalar exposes
 * its theme as CSS custom properties, so this is a re-skin rather than an
 * override of its layout.
 */
/**
 * The snippet picker offers two clients and no more: curl and Node.js.
 *
 * Scalar ships samples for twenty-two languages. A picker that long buries the
 * two an integrator here actually reaches for, and every extra sample is
 * another thing that can be subtly wrong without anyone noticing. Whole
 * languages are hidden with `true`; `shell` and `node` list the clients to
 * drop, leaving curl and fetch.
 */
const HIDDEN_CLIENTS: Record<string, true | string[]> = {
  c: true,
  clojure: true,
  csharp: true,
  dart: true,
  fsharp: true,
  go: true,
  http: true,
  java: true,
  js: true,
  julia: true,
  kotlin: true,
  objc: true,
  ocaml: true,
  php: true,
  powershell: true,
  python: true,
  r: true,
  ruby: true,
  rust: true,
  swift: true,
  shell: ['httpie', 'wget'],
  node: ['undici', 'native', 'axios', 'ofetch'],
};

const scalarTheme = `
  .scalar-app {
    /* Scalar sizes and sticks its own panes against the viewport. This is the
       supported way to tell it that the site header already occupies the top
       64px, so its sidebar and content start below rather than underneath. */
    --scalar-custom-header-height: 64px;

    /* Qatom BrandOS V3.1, light mode. The same values as src/styles/variables.css.
       Teal #1A7071 is the text accent; verdigris is never text. */
    --scalar-font: 'Hanken Grotesk', 'Segoe UI', system-ui, sans-serif;
    --scalar-font-code: 'IBM Plex Mono', Consolas, ui-monospace, monospace;
    --scalar-bold: 500;
    --scalar-semibold: 500;
    --scalar-color-1: #101415;
    --scalar-color-2: #4E5D64;
    --scalar-color-3: #5A6970;
    --scalar-color-accent: #1A7071;
    --scalar-link-color: #1A7071;
    --scalar-link-color-hover: #165F60;
    --scalar-background-1: #FFFFFF;
    --scalar-background-2: #F1F6FA;
    --scalar-background-3: #E9F1F6;
    --scalar-background-accent: hsla(195, 60%, 45%, .08);
    --scalar-border-color: rgba(23, 46, 64, .13);

    /* Method labels; Scalar also uses these for syntax colours
       (blue = strings, orange = numbers, purple = keywords). */
    --scalar-color-blue: #2B5E8C;   /* GET */
    --scalar-color-green: #1A7071;  /* POST */
    --scalar-color-orange: #172E36; /* PUT */
    --scalar-color-purple: #5B4E8C; /* PATCH */
    --scalar-color-red: #A33A2B;    /* DELETE */

    --scalar-button-1: #172E36;
    --scalar-button-1-hover: #1F3B44;
    --scalar-button-1-color: #F3F6F7;

    /* Sidebar: slate, matching the site frame. */
    --scalar-sidebar-background-1: #172E36;
    --scalar-sidebar-color-1: #F3F6F7;
    --scalar-sidebar-color-2: rgba(243, 246, 247, .74);
    --scalar-sidebar-color-active: #FFFFFF;
    --scalar-sidebar-item-hover-color: #FFFFFF;
    --scalar-sidebar-item-hover-background: hsla(171, 60%, 60%, .12);
    --scalar-sidebar-item-active-background: hsla(171, 55%, 60%, .20);
    --scalar-sidebar-border-color: rgba(255, 255, 255, .12);
    --scalar-sidebar-indent-border: rgba(255, 255, 255, .12);
    --scalar-sidebar-indent-border-hover: rgba(255, 255, 255, .24);
    --scalar-sidebar-indent-border-active: #79D2C5;
    --scalar-sidebar-search-background: rgba(255, 255, 255, .07);
    --scalar-sidebar-search-border-color: rgba(255, 255, 255, .12);
    --scalar-sidebar-search-color: rgba(243, 246, 247, .56);
  }

  /* Method labels inside the slate sidebar need the light set (light mode only). */
  .light-mode .scalar-app .t-doc__sidebar {
    --scalar-color-blue: #9CC3E6;
    --scalar-color-green: #9FE0D6;
    --scalar-color-orange: #C9D9E0;
    --scalar-color-purple: #C4BAF0;
    --scalar-color-red: #F0A397;
    --scalar-color-1: #F3F6F7;
    --scalar-color-2: rgba(243, 246, 247, .74);
    --scalar-color-3: rgba(243, 246, 247, .56);
  }

  /* Scalar's own attribution: the sidebar footer link and the watermark on an
     empty response pane. There is no configuration option for either, so they
     go by selector. Scalar is MIT licensed, so this is permitted.

     Scoped by href rather than by Scalar's utility classes, which change
     between releases — but excluding .disclaimerLink, because the Ask AI
     panel's Terms and Privacy Policy links also point at scalar.com and those
     stay. */
  .scalar-app a[href*='scalar.com']:not(.disclaimerLink) {
    display: none !important;
  }

  .dark-mode .scalar-app {
    /* Qatom BrandOS V3.1, dark mode: near-black frame and content;
       colour only in links, labels and the active item. */
    --scalar-color-1: #F3F6F7;
    --scalar-color-2: rgba(243, 246, 247, .68);
    --scalar-color-3: rgba(243, 246, 247, .58);
    --scalar-color-accent: #7DD0D0;
    --scalar-link-color: #7DD0D0;
    --scalar-link-color-hover: #F3F6F7;
    --scalar-background-1: #121313;
    --scalar-background-2: #181B1C;
    --scalar-background-3: #1D2122;
    --scalar-background-accent: hsla(180, 45%, 70%, .07);
    --scalar-border-color: rgba(220, 240, 245, .10);

    --scalar-color-blue: #9CC3E6;
    --scalar-color-green: #7DD0D0;
    --scalar-color-orange: #B8CDD6;
    --scalar-color-purple: #C4BAF0;
    --scalar-color-red: #F0A397;

    --scalar-button-1: #F3F6F7;
    --scalar-button-1-hover: #FFFFFF;
    --scalar-button-1-color: #121313;

    --scalar-sidebar-background-1: #0F1010;
    --scalar-sidebar-color-1: #F3F6F7;
    --scalar-sidebar-color-2: rgba(243, 246, 247, .74);
    --scalar-sidebar-color-active: #FFFFFF;
    --scalar-sidebar-item-hover-color: #FFFFFF;
    --scalar-sidebar-item-hover-background: hsla(171, 62%, 58%, .10);
    --scalar-sidebar-item-active-background: hsla(171, 60%, 56%, .16);
    --scalar-sidebar-border-color: rgba(220, 240, 245, .08);
    --scalar-sidebar-indent-border: rgba(220, 240, 245, .10);
    --scalar-sidebar-indent-border-hover: rgba(220, 240, 245, .20);
    --scalar-sidebar-indent-border-active: #79D2C5;
    --scalar-sidebar-search-background: #181C1D;
    --scalar-sidebar-search-border-color: rgba(220, 240, 245, .10);
    --scalar-sidebar-search-color: rgba(243, 246, 247, .56);
  }

  /* Type: no serif, sizes on the BrandOS scale. */
  .scalar-app .section-header-label {
    font-family: var(--scalar-font);
    font-weight: 500;
    line-height: 48px;
    letter-spacing: -.025em;
  }
  .scalar-app .markdown p,
  .scalar-app .markdown li { font-size: 15px; line-height: 25px; }
  .scalar-app .markdown h2 { font-size: 20px; line-height: 28px; letter-spacing: -.01em; }
  .scalar-app .markdown :not(pre) > code { font-size: 13px; }
  .scalar-app pre,
  .scalar-app pre code { font-family: var(--scalar-font-code); font-size: 13px; line-height: 1.65; }

  /* Syntax: keys in the accent (Scalar defaults them to body text). */
  .scalar-app .hljs-attr,
  .scalar-app .hljs-attribute { color: var(--scalar-color-accent); }

  /* Focus */
  .scalar-app :focus-visible { outline-color: #1A7071; }
  .dark-mode .scalar-app :focus-visible,
  .scalar-app .t-doc__sidebar :focus-visible { outline-color: #79D2C5; }

  .scalar-app .download-button { font-size: 15px; }
`;
---

<!doctype html>
<html lang="en">
  <Head />
  <body>
    <Header />

    <main class="reference-shell">
      <ScalarComponent
        renderMode="client"
        configuration={{
          url: openApiUrl,
          layout: 'modern',
          searchHotKey: 'k',
          hideModels: false,
          customCss: scalarTheme,
          hideClientButton: true,
          hiddenClients: HIDDEN_CLIENTS,
          defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
        }}
      />
    </main>

    <script is:inline>
      // Scalar mounts from the CDN after this runs, and decides its own initial
      // palette. Seed it from the visitor's stored choice so the reference opens
      // in the same mode as the rest of the site rather than following the OS
      // and then flipping.
      (function seedScalarTheme() {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (error) {
          // Private browsing; fall back to the OS preference.
        }

        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;

        document.querySelectorAll('[data-scalar-client]').forEach(function (element) {
          try {
            var configuration = JSON.parse(element.getAttribute('data-configuration') || '{}');
            configuration.darkMode = dark;
            element.setAttribute('data-configuration', JSON.stringify(configuration));
          } catch (error) {
            // Leave Scalar's own default in place.
          }
        });
      })();

      // Two theme switches now exist on this page: the site header's, which sets
      // `data-theme`, and Scalar's own, which sets `dark-mode` on the body.
      // Mirror each onto the other so either one moves the whole page.
      (function syncScalarTheme() {
        var root = document.documentElement;
        var body = document.body;
        var syncing = false;

        function siteIsDark() {
          return root.getAttribute('data-theme') === 'dark';
        }

        function scalarIsDark() {
          return body.classList.contains('dark-mode');
        }

        function pushToScalar() {
          if (syncing) return;
          syncing = true;
          body.classList.toggle('dark-mode', siteIsDark());
          body.classList.toggle('light-mode', !siteIsDark());
          syncing = false;
        }

        function pullFromScalar() {
          if (syncing || scalarIsDark() === siteIsDark()) return;
          syncing = true;
          var theme = scalarIsDark() ? 'dark' : 'light';
          root.setAttribute('data-theme', theme);
          try {
            localStorage.setItem('theme', theme);
          } catch (error) {
            // Nothing to persist to; the in-page state is still correct.
          }
          syncing = false;
        }

        pushToScalar();
        new MutationObserver(pushToScalar).observe(root, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
        new MutationObserver(pullFromScalar).observe(body, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Scalar scrolls the document itself and sticks its sidebar against the
     viewport, offset by --scalar-custom-header-height. The page must therefore
     keep its normal scrolling; the only thing to fix is the site header, so the
     sidebar has something to sit beneath. */
  body:has(.reference-shell) header.site-header {
    position: sticky;
    top: 0;
  }
</style>
