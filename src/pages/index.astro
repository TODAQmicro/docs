---
import { ScalarComponent } from '@scalar/astro';

import Head from '../components/Head.astro';
import Header from '../components/Header/Header.astro';
import '../styles/main.css';

/**
 * The reference renders whatever the API is currently serving. The payment API
 * generates its own OpenAPI document from the mounted route table and serves it
 * with permissive CORS, so the docs never need a vendored copy to refresh.
 *
 * Point PUBLIC_OPENAPI_URL at staging or a local server to preview changes
 * before they reach production.
 */
const openApiUrl =
  import.meta.env.PUBLIC_OPENAPI_URL ?? 'https://pay.m.todaq.net/v4/openapi.json';

/**
 * Aligns Scalar's palette and type with the rest of the site. Scalar exposes
 * its theme as CSS custom properties, so this is a re-skin rather than an
 * override of its layout.
 */
const scalarTheme = `
  .scalar-app {
    /* Scalar sizes and sticks its own panes against the viewport. This is the
       supported way to tell it that the site header already occupies the top
       64px, so its sidebar and content start below rather than underneath. */
    --scalar-custom-header-height: 64px;

    --scalar-font: 'Open Sans', ui-sans-serif, system-ui, sans-serif;
    --scalar-color-accent: #e2134c;
    --scalar-color-1: #2d334a;
    --scalar-background-1: #ffffff;
    --scalar-background-2: #f8f9fa;
    --scalar-border-color: rgba(45, 51, 74, 0.12);
    --scalar-radius: 8px;
    --scalar-radius-lg: 12px;
  }

  .dark-mode .scalar-app {
    --scalar-color-accent: #ff4d7d;
    --scalar-color-1: #e9ecef;
    --scalar-background-1: #25262b;
    --scalar-background-2: #1a1b1e;
    --scalar-border-color: rgba(233, 236, 239, 0.14);
  }
`;
---

<!doctype html>
<html lang="en">
  <Head />
  <body>
    <Header />

    <main class="reference-shell">
      <ScalarComponent
        renderMode="client"
        configuration={{
          url: openApiUrl,
          layout: 'modern',
          searchHotKey: 'k',
          hideModels: false,
          customCss: scalarTheme,
        }}
      />
    </main>

    <script is:inline>
      // Scalar mounts from the CDN after this runs, and decides its own initial
      // palette. Seed it from the visitor's stored choice so the reference opens
      // in the same mode as the rest of the site rather than following the OS
      // and then flipping.
      (function seedScalarTheme() {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (error) {
          // Private browsing; fall back to the OS preference.
        }

        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;

        document.querySelectorAll('[data-scalar-client]').forEach(function (element) {
          try {
            var configuration = JSON.parse(element.getAttribute('data-configuration') || '{}');
            configuration.darkMode = dark;
            element.setAttribute('data-configuration', JSON.stringify(configuration));
          } catch (error) {
            // Leave Scalar's own default in place.
          }
        });
      })();

      // Two theme switches now exist on this page: the site header's, which sets
      // `data-theme`, and Scalar's own, which sets `dark-mode` on the body.
      // Mirror each onto the other so either one moves the whole page.
      (function syncScalarTheme() {
        var root = document.documentElement;
        var body = document.body;
        var syncing = false;

        function siteIsDark() {
          return root.getAttribute('data-theme') === 'dark';
        }

        function scalarIsDark() {
          return body.classList.contains('dark-mode');
        }

        function pushToScalar() {
          if (syncing) return;
          syncing = true;
          body.classList.toggle('dark-mode', siteIsDark());
          body.classList.toggle('light-mode', !siteIsDark());
          syncing = false;
        }

        function pullFromScalar() {
          if (syncing || scalarIsDark() === siteIsDark()) return;
          syncing = true;
          var theme = scalarIsDark() ? 'dark' : 'light';
          root.setAttribute('data-theme', theme);
          try {
            localStorage.setItem('theme', theme);
          } catch (error) {
            // Nothing to persist to; the in-page state is still correct.
          }
          syncing = false;
        }

        pushToScalar();
        new MutationObserver(pushToScalar).observe(root, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
        new MutationObserver(pullFromScalar).observe(body, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Scalar scrolls the document itself and sticks its sidebar against the
     viewport, offset by --scalar-custom-header-height. The page must therefore
     keep its normal scrolling; the only thing to fix is the site header, so the
     sidebar has something to sit beneath. */
  body:has(.reference-shell) header.site-header {
    position: sticky;
    top: 0;
  }
</style>
