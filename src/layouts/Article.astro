---
import { getCollection } from 'astro:content';

import Head from '../components/Head.astro';
import Header from '../components/Header/Header.astro';
import Navigation from '../components/Navigation';
import Scripts from '../components/Scripts.astro';

import '../styles/main.css';

const guides = (await getCollection('guide')).sort((a, b) =>
  (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
  a.data.title.localeCompare(b.data.title)
);
// Content Layer collections come back in no fixed order: list references by
// path, as the file system did.
const allReferences = (await getCollection('reference')).sort((a, b) =>
  a.id.localeCompare(b.id)
);

// The HTTP API reference is no longer written by hand: it is rendered by Scalar
// at / from the OpenAPI document the payment API generates about itself. What
// remains in this collection is the SDK documentation, which Scalar does not
// cover.
const paymentJsIndex = allReferences.filter(entry => entry.id === 'payment-js');
const paymentJsChildren = allReferences.filter(entry => entry.id.startsWith('payment-js/'));

const generalReferences = allReferences.filter(entry => !entry.id.startsWith('payment-js'));
---

<!doctype html>
<html lang="en">
  <Head />
  <body>
    <Header />
    
    <div class="docs-layout">
      <aside class="sidebar">
        <h4>User Guides</h4>
        <Navigation entries={guides} root={true}/>
        
        <Navigation entries={generalReferences} root={true}/>
        
        <div class="nav-tree-node">
          <div class="nav-tree-header">Payment JS</div>
          <div class="nav-tree-children">
            <Navigation entries={paymentJsIndex} root={false}/>
            <Navigation entries={paymentJsChildren} root={false}/>
          </div>
        </div>

      </aside>
      <section class="main-content">
        <slot />        
      </section>
    </div>
    <Scripts />
  </body>
</html>
