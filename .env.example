# Where the API reference reads its OpenAPI document from.
#
# Defaults to production. The payment API generates this document from its own
# route table and serves it with permissive CORS, so the docs always render
# whatever that environment is actually running.
#
# PUBLIC_OPENAPI_URL=https://pay.stage.m.todaq.net/v4/openapi.json
# PUBLIC_OPENAPI_URL=http://localhost:8500/v4/openapi.json

# The demo account's client pair, used by the persona demo's server route
# (/api/delegate) to call the payment API. Server-only and required by that
# route, which answers 500 without them. Never give them a PUBLIC_ prefix:
# Astro inlines PUBLIC_* values into the build.
#
# The route reads process.env at request time, and Astro does not load this
# file into process.env. Export them in the shell that runs `npm run dev`, or
# start the built server with `node --env-file=.env ./dist/server/entry.mjs`.
# In production they come from the deployed service's environment.
#
# DELEGATE_CLIENT_ID=<CLIENT_ID>
# DELEGATE_CLIENT_SECRET=<CLIENT_SECRET>
